{
  "name": "your_app",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "test": "pnpm test:mobile && pnpm test:backend",
    "test:mobile": "bash ./bin/test-mobile.sh",
    "test:backend": "bash ./bin/test-backend.sh",
    "typecheck": "pnpm --filter @your-app/mobile typecheck",
    "check": "pnpm typecheck && pnpm test",
    "test:contracts": "pnpm --filter @your-app/contracts test",
    "bootstrap:mobile": "pnpm install"
  },
  "devDependencies": {
    "turbo": "2.11.6"
  }
}
